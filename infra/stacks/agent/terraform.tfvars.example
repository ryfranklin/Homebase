# Copy to terraform.tfvars (GIT-IGNORED) and fill in your inputs.
# Every value here is a FAKE placeholder. The real terraform.tfvars is never committed.

aws_region   = "<YOUR_AWS_REGION>"
project_name = "homebase"
environment  = "dev"

tags = {
  Owner = "<YOUR_NAME_OR_TEAM>"
}

# Model id the agent invokes via Converse. Current Claude models on Bedrock
# require a cross-region INFERENCE PROFILE id (us./eu./apac./global. prefix), e.g.
# us.anthropic.claude-sonnet-4-6; the bare on-demand foundation-model id returns
# ValidationException. Verify with:
#   aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId"
# The stack's IAM covers both the profile ARN and its underlying foundation-model ARNs.
model_id = "<YOUR_CLAUDE_INFERENCE_PROFILE_ID>"

# Optional extra model / inference-profile ARNs the agent may invoke.
additional_model_arns = []

# Optional: extra model ids a chat request may select (the GUI's settings-level
# default), beyond model_id which is always allowed. Their invoke ARNs are derived
# automatically (no need to also list them in additional_model_arns). Leave empty to
# disable model selection (the agent always uses model_id). Keep in sync with the web's
# VITE_CHAT_MODELS so the UI only offers models the agent is allowed to invoke.
# allowed_model_ids = ["us.anthropic.claude-haiku-4-5-20251001-v1:0", "us.anthropic.claude-opus-4-6-v1"]
allowed_model_ids = []

# Container image tag (built from services/agent and pushed to the ECR repo this
# stack creates).
agent_image_tag = "latest"

# Memory
memory_event_expiry_days       = 30
enable_long_term_memory        = true
long_term_memory_strategy_type = "SEMANTIC"

# Observability
enable_transaction_search_log_policy = true

# IANA timezone the agent resolves "today"/"now" in (falls back to UTC).
agent_timezone = "America/Chicago"
