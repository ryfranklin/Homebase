# ---------------------------------------------------------------------------
# Homebase example environment file
#
# Copy this to `.env` (which is git-ignored) and replace the placeholders with
# your real local values. Every value here is FAKE. Never commit a real .env.
#
# Real secrets belong in AWS Secrets Manager or SSM Parameter Store, not here.
# This file is for local development convenience only.
# ---------------------------------------------------------------------------

# --- AWS ---
# Region for local tooling. Example only.
AWS_REGION=<YOUR_AWS_REGION>
# SSO profile name used by `aws login`. Example only.
AWS_PROFILE=<YOUR_AWS_PROFILE>

# --- Web / BFF ---
# Base URL of the BFF API. Example only.
API_BASE_URL=https://api.example.invalid
# Public URL of the SPA. Example only.
WEB_BASE_URL=https://app.example.invalid

# --- Cognito (values are resolved at runtime from Terraform outputs) ---
# User pool and app client identifiers. Placeholders only.
COGNITO_USER_POOL_ID=<YOUR_COGNITO_USER_POOL_ID>
COGNITO_APP_CLIENT_ID=<YOUR_COGNITO_APP_CLIENT_ID>
COGNITO_DOMAIN=https://auth.example.invalid

# --- Google federation (register your own OAuth client) ---
# Do not commit real client IDs or secrets. Store the secret in Secrets Manager.
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
# GOOGLE_OAUTH_CLIENT_SECRET lives in AWS Secrets Manager, not in .env.

# --- Bedrock / AgentCore ---
BEDROCK_MODEL_ID=anthropic.claude-placeholder-model-id
KNOWLEDGE_BASE_ID=<YOUR_KNOWLEDGE_BASE_ID>
AGENTCORE_RUNTIME_ARN=<RESOLVED_FROM_TERRAFORM_OUTPUT>

# --- CLI ---
# Endpoint the thin chat CLI talks to. Example only.
CLI_API_URL=https://api.example.invalid

# --- Local development ---
LOG_LEVEL=info
