# ---------------------------------------------------------------------------
# Homebase .gitignore
# This repository is PUBLIC. When in doubt, ignore it.
# ---------------------------------------------------------------------------

# Environment files (never commit real values)
.env
.env.*
!.env.example

# Terraform variable files (real values are secret; examples are committed)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform state (may contain secrets in plaintext)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform working directories and plan output
.terraform/
*.tfplan
# Keep the dependency lock file committed
!.terraform.lock.hcl

# Terraform S3 backend partial config (contains bucket, region, key ARN)
backend.hcl
**/backend.hcl
!backend.hcl.example
!**/backend.hcl.example

# Private keys, certificates, and credential files
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
*.crt

# AWS credentials and config
.aws/
aws-exports.js
credentials
.credentials

# Generic secret and credential file patterns
*secret*
*secrets*
*.secret
*.secrets
*_secret.*
*credentials*.json
*.credentials.json
secrets.*.yaml
secrets.*.yml
!**/secrets.example.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
