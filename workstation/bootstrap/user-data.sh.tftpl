#!/bin/bash
# Workstation bootstrap (cloud-init user-data).
#
# Installs the dev toolchain and wires the shell environment. It contains NO real
# repo URL, account, or secret: the dotfiles repo URL and the shell-secret name
# are read from SSM parameters at boot, and the secret itself is pulled from
# Secrets Manager at SESSION START using the instance role. No long-lived key is
# ever written to disk.
#
# Note on templating: this file is rendered by Terraform's templatefile(). Only
# ${aws_region}, ${project_name}, ${environment}, ${workstation_user},
# ${home_device}, ${cockpit_model}, and ${cockpit_small_model} are Terraform
# values; all shell variables use $VAR (no braces) so they pass through untouched.
set -euo pipefail
exec > >(tee /var/log/homebase-bootstrap.log) 2>&1

REGION="${aws_region}"
PROJECT="${project_name}"
ENVIRONMENT="${environment}"
WS_USER="${workstation_user}"
HOME_DEVICE="${home_device}"

# --- wait for outbound egress via the NAT ---
# The private subnet reaches the internet only through the NAT instance, which may
# still be finishing its own setup at first boot; the box also stops/starts
# nightly. Wait for connectivity instead of failing the whole bootstrap (which is
# what happened when dnf ran before the NAT was ready).
for i in $(seq 1 60); do
  if curl -fsS -m 5 -o /dev/null https://aws.amazon.com; then
    echo "egress up (attempt $i)"; break
  fi
  echo "waiting for egress via NAT... ($i)"; sleep 10
done

# dnf with a few retries, to ride out transient repo timeouts.
dnf_install() { for _ in 1 2 3 4 5; do dnf install -y "$@" && return 0; sleep 10; done; return 1; }

# --- toolchain: git, docker, python, node, aws cli ---
dnf_install git docker python3 python3-pip unzip tar gzip
systemctl enable --now docker
usermod -aG docker "$WS_USER" || true
dnf_install nodejs20 || dnf_install nodejs || true

# Claude Code CLI: the interactive cockpit. It reaches Claude via Bedrock using
# the instance role (see the profile.d env below), so no API key is ever stored.
npm install -g @anthropic-ai/claude-code || true

# GitHub CLI (gh): used for `gh pr create` from the box in the Phase 2 vault loop.
# The token is supplied at runtime by the gh wrapper in the session profile (fetched
# from Secrets Manager per call), never stored in gh's on-disk config. Non-fatal:
# if gh is unavailable, `git push` still works and PRs can be opened in the browser.
dnf_install dnf-plugins-core || true
dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo 2>/dev/null \
  || curl -fsSL https://cli.github.com/packages/rpm/gh-cli.repo -o /etc/yum.repos.d/gh-cli.repo 2>/dev/null || true
dnf_install gh || echo "gh install skipped (optional; git push still works)"

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscliv2.zip
  (cd /tmp && unzip -q awscliv2.zip && ./aws/install)
fi

# --- persistent, encrypted home volume mounted at /workspace ---
mkdir -p /workspace
DEV=""
for d in /dev/nvme1n1 "$HOME_DEVICE" /dev/xvdf; do
  if [ -b "$d" ]; then DEV="$d"; break; fi
done
if [ -n "$DEV" ]; then
  if ! blkid "$DEV" >/dev/null 2>&1; then mkfs.ext4 -L homebase-home "$DEV"; fi
  grep -q "/workspace" /etc/fstab || echo "LABEL=homebase-home /workspace ext4 defaults,nofail 0 2" >> /etc/fstab
  mount -a || true
  chown "$WS_USER":"$WS_USER" /workspace || true
fi

# --- session bootstrap: dotfiles + secrets pulled at login, never baked ---
cat > /etc/profile.d/homebase-session.sh <<'PROFILE'
# Runs at each login. Clones dotfiles and materializes the machine-local shell
# secret (the ~/.zshrc.local pattern) using the instance role. It NEVER writes an
# access key; credentials come from the instance role and short-lived role
# assumption only.
homebase_session_bootstrap() {
  local region prefix url secret_name auth_secret token askpass
  region="__REGION__"
  prefix="/__PROJECT__/__ENVIRONMENT__/workstation"

  url="$(aws ssm get-parameter --region "$region" --name "$prefix/dotfiles_repo_url" --query Parameter.Value --output text 2>/dev/null || echo unset)"
  if [ "$url" != "unset" ] && [ -n "$url" ] && [ ! -d "$HOME/.dotfiles" ]; then
    # A private repo needs a credential. If a git-auth secret is configured, pull
    # the token and clone via GIT_ASKPASS so the token is never in argv, on disk,
    # or persisted in the cloned repo's remote URL. Otherwise clone unauthenticated
    # (works only for a public repo).
    auth_secret="$(aws ssm get-parameter --region "$region" --name "$prefix/dotfiles_auth_secret_name" --query Parameter.Value --output text 2>/dev/null || echo unset)"
    token=""
    if [ -n "$auth_secret" ] && [ "$auth_secret" != "unset" ]; then
      token="$(aws secretsmanager get-secret-value --region "$region" --secret-id "$auth_secret" --query SecretString --output text 2>/dev/null || echo)"
    fi

    if [ -n "$token" ]; then
      # Write a tiny askpass helper (no secret in it; it just echoes an env var).
      askpass="$(mktemp)"
      echo '#!/bin/sh' > "$askpass"
      echo 'exec echo "$HB_GIT_TOKEN"' >> "$askpass"
      chmod 700 "$askpass"
      # username x-access-token is GitHub's PAT convention (not secret); the token
      # is supplied only via the env var the askpass helper echoes, so it never
      # appears in argv, on disk, or in the cloned repo's stored remote URL.
      HB_GIT_TOKEN="$token" GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
        git clone "https://x-access-token@$${url#https://}" "$HOME/.dotfiles" 2>/dev/null && \
        { git -C "$HOME/.dotfiles" remote set-url origin "$url" 2>/dev/null || true; } && \
        { [ -x "$HOME/.dotfiles/install.sh" ] && "$HOME/.dotfiles/install.sh" || true; }
      rm -f "$askpass"
      unset HB_GIT_TOKEN token
    else
      git clone "$url" "$HOME/.dotfiles" 2>/dev/null && \
        { [ -x "$HOME/.dotfiles/install.sh" ] && "$HOME/.dotfiles/install.sh" || true; }
    fi
  fi

  # --- Phase 2: clone the git-authoritative vault onto persistent /workspace and
  # wire read-write git. The PAT is fetched from Secrets Manager on demand by a
  # credential helper, so no token is ever written to disk or into a remote URL. ---
  local vault_url vault_secret vault_name vault_email vault_dir cred
  vault_url="$(aws ssm get-parameter --region "$region" --name "$prefix/vault_repo_url" --query Parameter.Value --output text 2>/dev/null || echo unset)"
  if [ "$vault_url" != "unset" ] && [ -n "$vault_url" ]; then
    mkdir -p "$HOME/.homebase"
    vault_secret="$(aws ssm get-parameter --region "$region" --name "$prefix/vault_auth_secret_name" --query Parameter.Value --output text 2>/dev/null || echo unset)"
    vault_name="$(aws ssm get-parameter --region "$region" --name "$prefix/vault_git_user_name" --query Parameter.Value --output text 2>/dev/null || echo unset)"
    vault_email="$(aws ssm get-parameter --region "$region" --name "$prefix/vault_git_user_email" --query Parameter.Value --output text 2>/dev/null || echo unset)"
    [ "$vault_name" != "unset" ] && [ -n "$vault_name" ] && git config --global user.name "$vault_name"
    [ "$vault_email" != "unset" ] && [ -n "$vault_email" ] && git config --global user.email "$vault_email"

    if [ "$vault_secret" != "unset" ] && [ -n "$vault_secret" ]; then
      # Credential helper: for each github.com git op, fetch the PAT via the instance
      # role and hand it to git on stdout. The token exists only for that op; it is
      # never stored on disk or in the repo remote. The baked-in values (region and
      # the secret NAME) are not secret.
      cred="$HOME/.homebase/git-credential-vault"
      cat > "$cred" <<CREDEOF
#!/bin/sh
[ "\$1" = get ] || exit 0
tok=\$(aws secretsmanager get-secret-value --region '$region' --secret-id '$vault_secret' --query SecretString --output text 2>/dev/null)
[ -n "\$tok" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "\$tok"
CREDEOF
      chmod 700 "$cred"
      git config --global "credential.https://github.com.helper" "$cred"
      # Non-secret pointers so the gh wrapper (below) can fetch a token per call.
      printf 'HB_VAULT_REGION=%s\nHB_VAULT_SECRET=%s\n' "$region" "$vault_secret" > "$HOME/.homebase/vault-env"
    fi

    # Clone once onto the persistent volume; later logins skip. The clone survives
    # instance replacement because /workspace is a separate EBS volume.
    vault_dir="/workspace/$(basename "$vault_url" .git)"
    # Trust the vault working tree regardless of which uid cloned it. /workspace persists
    # across instance replacement, so the clone owner can differ from the current login user,
    # and git then refuses every op with "dubious ownership". Add once (idempotent per login).
    git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$vault_dir" \
      || git config --global --add safe.directory "$vault_dir"
    if [ -d /workspace ] && [ ! -d "$vault_dir/.git" ]; then
      git clone "$vault_url" "$vault_dir" 2>/dev/null || echo "homebase: vault clone deferred (egress or credentials not ready yet)"
    fi
  fi

  secret_name="$(aws ssm get-parameter --region "$region" --name "$prefix/dotfiles_secret_name" --query Parameter.Value --output text 2>/dev/null || echo)"
  if [ -n "$secret_name" ] && [ "$secret_name" != "unset" ]; then
    if aws secretsmanager get-secret-value --region "$region" --secret-id "$secret_name" \
        --query SecretString --output text 2>/dev/null > "$HOME/.zshrc.local.tmp"; then
      mv "$HOME/.zshrc.local.tmp" "$HOME/.zshrc.local"
      chmod 600 "$HOME/.zshrc.local"
    else
      rm -f "$HOME/.zshrc.local.tmp"
    fi
  fi
}
homebase_session_bootstrap

# gh wrapper: hand the GitHub CLI a token fetched from Secrets Manager per call, so
# `gh pr create` works without persisting a token in gh's on-disk config. No-op if
# gh is not installed or the vault credential is not configured.
if command -v gh >/dev/null 2>&1 && [ -f "$HOME/.homebase/vault-env" ]; then
  gh() {
    local _t=""
    . "$HOME/.homebase/vault-env"
    [ -n "$HB_VAULT_SECRET" ] && _t="$(aws secretsmanager get-secret-value --region "$HB_VAULT_REGION" --secret-id "$HB_VAULT_SECRET" --query SecretString --output text 2>/dev/null)"
    GH_TOKEN="$_t" command gh "$@"
  }
fi
PROFILE

# Bake only non-secret pointers (region/project/env) into the profile script.
sed -i "s|__REGION__|$REGION|g; s|__PROJECT__|$PROJECT|g; s|__ENVIRONMENT__|$ENVIRONMENT|g" /etc/profile.d/homebase-session.sh
chmod 644 /etc/profile.d/homebase-session.sh

# --- Claude Code on Bedrock: no API key; credentials come from the instance role.
# Written only when a cockpit model is configured. The model ids are Terraform
# values (not secret); the region is already an input. CLAUDE_CODE_USE_BEDROCK
# tells the CLI to authenticate to Bedrock with the ambient AWS credentials.
if [ -n "${cockpit_model}" ]; then
  cat > /etc/profile.d/claude-code.sh <<'CLAUDE'
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION="${aws_region}"
export ANTHROPIC_MODEL="${cockpit_model}"
export ANTHROPIC_SMALL_FAST_MODEL="${cockpit_small_model}"
CLAUDE
  chmod 644 /etc/profile.d/claude-code.sh
fi

echo "homebase workstation bootstrap complete"
