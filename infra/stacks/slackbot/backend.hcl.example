# Copy to backend.hcl (GIT-IGNORED) and fill in with the bootstrap stack outputs.
# Then run: terraform -chdir=infra/stacks/slackbot init -backend-config=backend.hcl
#
# Every value here is a FAKE placeholder. The real backend.hcl is never committed.

bucket         = "<YOUR_STATE_BUCKET_NAME>"
key            = "slackbot/terraform.tfstate"
region         = "<YOUR_AWS_REGION>"
dynamodb_table = "<YOUR_LOCK_TABLE_NAME>"
encrypt        = true
kms_key_id     = "<YOUR_STATE_KMS_KEY_ARN>"
