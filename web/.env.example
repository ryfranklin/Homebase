# Copy to .env.local (git-ignored) for local dev, or inject these at build time
# in CI. Every value here is a FAKE placeholder. Real identity config is never
# committed; the SPA reads it from these VITE_ env vars at build/runtime.

# Cognito
VITE_COGNITO_USER_POOL_ID=<YOUR_COGNITO_USER_POOL_ID>
VITE_COGNITO_CLIENT_ID=<YOUR_COGNITO_APP_CLIENT_ID>
VITE_COGNITO_HOSTED_UI_DOMAIN=https://auth.example.invalid
VITE_COGNITO_SCOPES=openid email profile

# OAuth redirect targets (the SPA origin)
VITE_REDIRECT_URI=https://app.example.invalid/auth/callback
VITE_LOGOUT_URI=https://app.example.invalid/

# API base (CloudFront origin; /api/* is routed to the streaming BFF)
VITE_API_BASE_URL=https://app.example.invalid
