# Copy to terraform.tfvars (GIT-IGNORED) and fill in your inputs.
# Every value here is a FAKE placeholder. The real terraform.tfvars is never committed.

aws_region   = "<YOUR_AWS_REGION>"
project_name = "homebase"
environment  = "dev"

tags = {
  Owner = "<YOUR_NAME_OR_TEAM>"
}

# From the foundation stack (P2). This stack adds the VPC's internet gateway and
# egress path.
vpc_id = "<YOUR_VPC_ID>"

az_index                = 0
workstation_subnet_cidr = "10.0.20.0/24"
public_subnet_cidr      = "10.0.21.0/24"

# Egress: the stoppable NAT instance (cheaper) by default; nat_gateway is managed
# but always-on and pricier.
nat_egress_type   = "nat_instance"
nat_instance_type = "t4g.nano"

# Instance and storage. Scale-down levers: lower instance_type and re-apply to
# shrink compute (stop -> change type -> start; a stopped box costs only EBS).
# NOTE: EBS volumes can GROW but not SHRINK, so pick root/home sizes you are happy
# to keep; reducing them later requires rebuilding the volume.
instance_type    = "t4g.medium" # e.g. t4g.small / t4g.micro to scale down
root_volume_size = 30
home_volume_size = 50
workstation_user = "ec2-user"

# Dotfiles + secrets. The real repo URL and secrets live outside the repo.
dotfiles_repo_url    = "<YOUR_DOTFILES_GIT_URL>"
dotfiles_secret_name = "homebase/workstation/shell-secrets"

# Cloning a PRIVATE dotfiles repo: name of a by-hand Secrets Manager secret
# holding a GitHub fine-grained PAT (read-only Contents on just that repo). Empty
# = unauthenticated clone (public repos only). The token is never committed.
dotfiles_auth_secret_name = "homebase/workstation/dotfiles-auth"

# Vault clone (Phase 2): clone the git-authoritative knowledge vault onto the
# persistent /workspace so Claude Code can edit -> commit -> push a branch -> open a
# PR, like the local Obsidian loop. vault_auth_secret_name is a by-hand Secrets
# Manager secret holding a GitHub fine-grained PAT on JUST the vault repo, with
# Contents: read+write and Pull requests: read+write (the latter for `gh pr create`).
# The token is fetched on demand by a credential helper, never written to disk.
# Empty vault_repo_url skips the whole vault clone. All values here are fake.
vault_repo_url         = "<YOUR_VAULT_GIT_URL>"
vault_auth_secret_name = "homebase/workstation/vault-auth"
vault_git_user_name    = "<YOUR_GIT_AUTHOR_NAME>"
vault_git_user_email   = "you@example.invalid"

# Task-specific roles the instance may assume for short-lived credentials.
# Broad operations go through these, not standing instance permissions.
assumable_role_arns = []

# Auto-stop: scheduled (also stops the NAT instance), activity, or none.
auto_stop_mode = "scheduled"
stop_schedule  = "cron(0 3 * * ? *)"

# Claude Code cockpit. The interactive `claude` CLI reaches Bedrock via the
# instance role (no API key on the box). cockpit_model is the primary model; the
# small/fast model defaults to Haiku 4.5. Both must be ENABLED in Bedrock for the
# account: verified 2026-08-17 that Opus 4.8/5 and Sonnet 5 return AccessDenied
# here, while Sonnet 4.6 and Haiku 4.5 are enabled. Empty cockpit_model skips the
# Bedrock env + grant.
cockpit_model = "us.anthropic.claude-sonnet-4-6" # top enabled Anthropic model in this account
# cockpit_small_model defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0 (enabled)
